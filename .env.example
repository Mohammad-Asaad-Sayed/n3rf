# n3rf local environment. Copy to .env and fill in what you use — never commit .env.
# ./scripts/run.sh loads .env automatically (KEY=value lines only).

# Pick the provider you actually use; one key is usually enough.
OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# HUGGINGFACE_API_KEY=
# CLOUDFLARE_API_TOKEN=

# Optional overrides
# N3RF_DB_PATH=./n3rf.sqlite3
# PORT=8000
